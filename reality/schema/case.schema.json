{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vermory.dev/schema/reality-case-v1.json",
  "title": "Vermory Reality Case Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "title",
    "evidence_level",
    "continuity_lines",
    "pressures",
    "sources",
    "anchors",
    "expectations",
    "task"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "evidence_level": {
      "enum": ["public", "withheld_local"]
    },
    "continuity_lines": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["workspace", "conversation", "global_defaults", "bridge", "security"]
      }
    },
    "pressures": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "anchors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/anchor"
      }
    },
    "expectations": {
      "$ref": "#/$defs/expectations"
    },
    "task": {
      "$ref": "#/$defs/task"
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "fixture_path", "sha256", "authorized", "anonymization"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "fixture_path": {
          "type": "string",
          "minLength": 1
        },
        "original_ref": {
          "type": "string"
        },
        "original_revision": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "authorized": {
          "const": true
        },
        "anonymization": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value", "ambiguous"],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "ambiguous": {
          "type": "boolean"
        }
      }
    },
    "expectations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_facts", "forbidden_facts", "expected_action"],
      "properties": {
        "current_facts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbidden_facts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allowed_unknowns": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expected_action": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt", "deterministic_checks"],
      "properties": {
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "artifact_checks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "deterministic_checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
